@model DeliveryOrderApp.Models.PagedResult<DeliveryOrderApp.Models.Order>

@{
    ViewData["Title"] = "Список заказов";
}

<h2>Список заказов</h2>

<p>
    <a asp-action="Create" class="btn btn-success">Создать новый заказ</a>
</p>

<table class="table table-striped table-hover">
        <tr>
            <th>Номер заказа</th>
            <th>Город отправителя</th>
            <th>Город получателя</th>
            <th>Вес (кг)</th>
            <th>Дата забора</th>
            <th>Действия</th>
        </tr>
    <tbody>
    
@foreach (var item in Model.Items) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.SenderCity)</td>
            <td>@Html.DisplayFor(modelItem => item.RecipientCity)</td>
            <td>@Html.DisplayFor(modelItem => item.Weight) кг</td>
            <td>@Html.DisplayFor(modelItem => item.PickupDate)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">Назад</a>
        </li>
        
        <li class="page-item disabled">
            <span class="page-link">Страница @Model.CurrentPage из @Model.TotalPages</span>
        </li>
        
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">Вперед</a>
        </li>
    </ul>
</nav>